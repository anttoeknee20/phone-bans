---
title: "Do State Phone Bans at School Really Improve Student Performance?"
subtitle: "Evaluating the empirical impact of statewide K-12 cell phone restrictions across the U.S."
author: "Anthony Gao"
page-layout: full
execute:
  warning: false
  message: false
  echo: false
  fig-width: 10
  fig-height: 6.5
  out-width: "90%"
---

```{r}
#| label: fig-la-parish-heatmap
#| fig-cap: "Model-predicted cell phone ban policy impact across Louisiana parishes (Grades 3-12 All Subjects)."
#| fig-align: "center"

library(readr)
library(dplyr)
library(ggplot2)
library(marginaleffects)
library(tigris)
library(sf)

data_path_la <- if (file.exists("data/clean/louisiana_wide_clean.csv")) {
  "data/clean/louisiana_wide_clean.csv"
} else {
  "../data/clean/louisiana_wide_clean.csv"
}

la_wide <- read_csv(data_path_la, show_col_types = FALSE) |>
  filter(g3_12system_code != "LA") |>
  mutate(
    period = factor(period, levels = c("pre_ban", "post_ban")),
    parish_name = gsub(" Parish", "", system_name)
  )

fit_parish <- lm(g3_12_all_subjects ~ period * parish_name, data = la_wide)
parish_slopes <- avg_slopes(fit_parish, variables = "period", by = "parish_name") |>
  select(parish_name, ban_effect = estimate)

options(tigris_use_cache = TRUE)
la_map <- suppressMessages(counties(state = "LA", cb = TRUE, year = 2022)) |>
  left_join(parish_slopes, by = c("NAME" = "parish_name"))

ggplot(la_map) +
  geom_sf(aes(fill = ban_effect), color = "white", linewidth = 0.25) +
  scale_fill_gradient2(
    low = "#2980b9",
    mid = "#ffffff",
    high = "#c0392b",
    midpoint = 0,
    limits = c(-6, 7),
    name = "Ban Effect (% pts)",
    na.value = "gray90"
  ) +
  labs(
    title = "Louisiana Parish Heat Map: Model-Predicted Phone Ban Impact",
    subtitle = "Warm colors = positive gains, White = 0%, Cool colors = decline (Grades 3-12, All Subjects)"
  ) +
  theme_void(base_size = 14) +
  theme(
    plot.title = element_text(face = "bold", size = 16, hjust = 0.5, margin = margin(b = 4)),
    plot.subtitle = element_text(size = 12, hjust = 0.5, color = "gray20", margin = margin(b = 10)),
    legend.position = "right"
  )
```

## Project Overview

In recent years, several states have enacted statewide restrictions on student cell phone usage during school hours. This website looks into the empirical effect of these policies on student academic performance, focusing on standardized test results in **Louisiana** (LEAP 2025 assessments) and **South Carolina** (SC READY assessments).

